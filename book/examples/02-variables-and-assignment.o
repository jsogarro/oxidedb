// Chapter 2: Variables and Assignment Examples
// This file demonstrates variable assignment and usage concepts

// Basic Variable Assignment
// Assignment returns the value that was assigned
// Expected output: 5
x:5

// Variable Retrieval
// Simply reference the variable name
// Expected output: 5
x

// Using Variables in Expressions
// Expected output: 10
y:10

// Variables can be used in arithmetic expressions
// Expected output: 15
z:x+y

// Verify the result
// Expected output: 15
z

// Right-to-Left Evaluation with Variables
// Expected output: 3
a:3

// Right-to-left: a * (2 + 1) = 3 * 3 = 9
// Expected output: 9
b:a*2+1

// Verify the assignment worked
// Expected output: 9
b

// More Complex Variable Examples
// Expected output: 5
width:5

// Expected output: 3
height:3

// Expected output: 15
area:width*height

// Expected output: 15
area

// Floating Point Variables
// Expected output: 3.14159
pi:3.14159

// Expected output: 2.5
radius:2.5

// Right-to-left: 2 * (pi * radius) = 2 * (3.14159 * 2.5) = 2 * 7.853975 = 15.70795
// Expected output: 15.70795
circumference:2*pi*radius

// Expected output: 15.70795
circumference

// Variable Reassignment
// Variables can be updated with new values
// Expected output: 1
counter:1

// Self-referencing assignment: counter gets counter + 1
// Expected output: 2
counter:counter+1

// Verify the update
// Expected output: 2
counter

// Working with Different Types
// Expected output: 42
number:42

// Expected output: 3.14
decimal:3.14

// Expected output: 1b
flag:1b

// Expected output: "X"
letter:"X"

// Mixed Type Arithmetic
// Expected output: 5
int_val:5

// Expected output: 2f
float_val:2.0

// O handles type conversion automatically
// Expected output: 10f
result:int_val*float_val

// Expected output: 10f
result

// Chained Variable Dependencies
// Expected output: 10
base:10

// Expected output: 20
doubled:base*2

// Expected output: 30
total:base+doubled

// Expected output: 30
total

// Temperature Conversion Example
// Expected output: 25
celsius:25

// Due to right-to-left evaluation, we need parentheses for proper temperature conversion
// celsius*9%5+32 would be evaluated as celsius*(9%(5+32)) = 25*(9%37) = 25*0.2432432 = 6.081081
// Let's demonstrate this first:
// Expected output: 6.081081
wrong_temp:celsius*9%5+32

// Expected output: 6.081081
wrong_temp

// For proper temperature conversion, we need to use parentheses or separate steps
// Step-by-step conversion:
// Expected output: 1.8
ratio:9%5

// Expected output: 845f (right-to-left: 25 * (1.8 + 32) = 25 * 33.8 = 845)
fahrenheit:celsius*ratio+32

// Expected output: 845f
fahrenheit

// Better temperature conversion with floats for accurate ratio
// Expected output: 20f
celsius_float:20.0

// Expected output: 1.8
ratio_float:9.0%5.0

// Expected output: 676f (right-to-left: 20.0 * (1.8 + 32) = 20.0 * 33.8 = 676)
fahrenheit_float:celsius_float*ratio_float+32

// Expected output: 676f
fahrenheit_float
// A minus applied to a variable negates everything to its right: -x+3 is -(x+3)
// Expected output: 2
neg_x:2

// Expected output: -5
-neg_x+3

// Names start with a letter; digits and underscores may follow
// Expected output: 7
x1_a:7
